<% layout("/layouts/boilerplate") %>

<!-- ================= FILTERS ================= -->

<div class="filters-container">

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-solid fa-arrow-trend-up"></i></div>
        <span>Trending</span>
    </div>

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-solid fa-hotel"></i></div>
        <span>Rooms</span>
    </div>

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-brands fa-fort-awesome"></i></div>
        <span>Castles</span>
    </div>

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-solid fa-person-swimming"></i></div>
        <span>Amazing Pools</span>
    </div>

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-solid fa-mountain"></i></div>
        <span>Mountains</span>
    </div>

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-solid fa-tents"></i></div>
        <span>Camping</span>
    </div>

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-solid fa-seedling"></i></div>
        <span>Farms</span>
    </div>

    <div class="filter-item">
        <div class="filter-icon"><i class="fa-brands fa-medrt"></i></div>
        <span>Arctic</span>
    </div>

</div>


<!-- ================= ALL LISTINGS ================= -->

<h3 class="listing-heading">All Listings</h3>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% for(let listing of allListings) { %>

        <a
            href="/listings/<%= listing._id %>"
            class="listing-link"
        >

            <div class="card col mb-4 listing-card">

                <img
                    src="<%= listing.image.url ? listing.image.url : listing.image %>"
                    class="card-img-top"
                    alt="listing_image"
                >

                <div class="card-body">

                    <p class="card-text">

                        <b><%= listing.title %></b>

                        <br>

                        &#8377;
                        <%= listing.price.toLocaleString("en-IN") %>
                        / night

                    </p>

                </div>

            </div>

        </a>

    <% } %>

</div>

