<!DOCTYPE html>
<html lang="en">
<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<style>
    #map {
        height: 400px;
        width: 100%;
        margin-top: 20px;
    }
</style>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wanderlust</title>

    <!-- Leaflet CSS -->
    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />

    <style>
        #map {
            height: 400px;
            width: 100%;
            margin-top: 30px;
            border-radius: 15px;
        }
    </style>

</head>

<body>

    <% layout("/layouts/boilerplate") %>


    <!-- ================= LISTING CARD ================= -->

    <div class="card" style="width: 18rem;">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            alt="listing_image"
        >

        <div class="card-body">

            <p class="card-text">
                <%= listing.title %>
            </p>

        </div>

    </div>


    <!-- ================= LISTING DETAILS ================= -->

    <ul>

        <li>
            <%= listing.title %>
        </li>

        <li>
            <%= listing.description %>
        </li>

        <li>
            ₹ <%= listing.price %>
        </li>

        <li>
            <%= listing.location %>
        </li>

        <li>
            <%= listing.country %>
        </li>

    </ul>


    <!-- ================= MAP ================= -->

    <h3>Location</h3>

    <div id="map"></div>


    <!-- ================= EDIT ================= -->

    <br>

    <a href="/listings/<%= listing._id %>/edit">
        Edit this Listing
    </a>


    <br><br>


    <!-- ================= DELETE ================= -->

    <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
    >

        <button>
            Delete this Listing
        </button>

    </form>


    <!-- ================= REVIEW FORM ================= -->

    <br>

    <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
    >

        <div>

            <label for="Rating">
                Rating
            </label>

            <input
                type="range"
                min="1"
                max="5"
                id="Rating"
                name="review[rating]"
                value="3"
            >

        </div>


        <div>

            <label for="comment">
                Comment
            </label>

            <textarea
                name="review[comment]"
                id="comment"
                cols="30"
                rows="10"
                required
            ></textarea>

        </div>


        <button>
            Submit
        </button>

    </form>


    <hr>


    <!-- ================= REVIEWS ================= -->

    <h3>Reviews</h3>


    <% if (listing.reviews.length === 0) { %>

        <p>
            No reviews yet.
        </p>

    <% } else { %>


        <% listing.reviews.forEach(review => { %>

            <div class="review-card">

                <p>
                    <strong>Rating:</strong>
                    ⭐ <%= review.rating %>/5
                </p>

                <p>
                    <strong>Comment:</strong>
                    <%= review.comment %>
                </p>

            </div>

        <% }); %>


    <% } %>


    <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>

<script>

    const locationName =
        "<%= listing.location %>, <%= listing.country %>";

    console.log("Searching location:", locationName);


    fetch(
        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationName)}`
    )
    .then(response => response.json())

    .then(data => {

        if (data.length === 0) {

            console.log("Location not found");

            document.getElementById("map").innerHTML =
                "<p>Location not found on map.</p>";

            return;
        }


        const latitude = parseFloat(data[0].lat);
        const longitude = parseFloat(data[0].lon);


        // Create map

        const map = L.map("map").setView(
            [latitude, longitude],
            10
        );


        // OpenStreetMap

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution:
                    "&copy; OpenStreetMap contributors"
            }
        ).addTo(map);


        // Marker

        L.marker([latitude, longitude])
            .addTo(map)
            .bindPopup(
                `<b><%= listing.title %></b><br>
                 <%= listing.location %>, <%= listing.country %>`
            )
            .openPopup();

    })

    .catch(error => {

        console.log("MAP ERROR:", error);

    });

</script>

</body>
</html>

